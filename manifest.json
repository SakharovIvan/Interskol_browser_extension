{
  "manifest_version": 3,
  "name": "Interskol mat_no search",
  "version": "1.0.1",

  "description": "Adds a special extension for searching mat_no",
  "permissions": ["contextMenus", "tabs", "activeTab"],
  "icons": {
    "16": "icons/logo16.png",
    "32": "icons/logo32.png",
    "48": "icons/logo48.png",
    "64": "icons/logo64.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gis.kls-gr.ru/app/GIS"
      ]
    }
  ]
}
